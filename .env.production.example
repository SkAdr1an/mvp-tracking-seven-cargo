# Infraestrutura (usada pelo Docker Compose/Caddy)
APP_DOMAIN=tracking.example.com
ACME_EMAIL=admin@example.com

# Segurança do painel
APP_ENVIRONMENT=production
PANEL_ADMIN_USERNAME=
PANEL_ADMIN_PASSWORD_HASH=
PANEL_ADMIN_ROLE=Administrador
PANEL_USERS_FILE=
PANEL_SESSION_SECRET=
PANEL_SESSION_TTL_HOURS=12
PANEL_COOKIE_SECURE=true
FORCE_HTTPS=true
EXPOSE_API_DOCS=false
ALLOWED_HOSTS=tracking.example.com
FRONTEND_ORIGINS=https://tracking.example.com
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
SENSITIVE_RATE_LIMIT_ATTEMPTS=30
SENSITIVE_RATE_LIMIT_WINDOW_SECONDS=60

# Exceção temporária por IP (use estas definições juntas e somente
# enquanto 190.2.184.66 for o endpoint de produção):
# APP_DOMAIN=190.2.184.66
# FRONTEND_ORIGINS=http://190.2.184.66
# ALLOWED_HOSTS=190.2.184.66
# FORCE_HTTPS=false
# PANEL_COOKIE_SECURE=false
# PUBLIC_TRIP_BASE_URL=http://190.2.184.66/viagem

# Portal público
PUBLIC_TRIP_INTERNAL_API_KEY=
PUBLIC_TRIP_TOKEN_PEPPER=
PUBLIC_TRIP_BASE_URL=https://tracking.example.com/viagem
PUBLIC_TRIP_DEFAULT_TTL_HOURS=168
PUBLIC_TRIP_CONTACT_NAME=Central Seven Cargo
PUBLIC_TRIP_CONTACT_PHONE=
PUBLIC_TRIP_INSTRUCTIONS=
DRIVER_MOBILE_LOCATION_ENABLED=false
DRIVER_PORTAL_ALERTS_ENABLED=false
DRIVER_PORTAL_PILOT_TRIP_KEYS=

# Integrações externas de leitura
TRAFEGUS_API_KEY=
TRAFEGUS_API_URL=https://sevencargo.trafegus.com.br/ws_rest/public/api
TRAFEGUS_USERNAME=
TRAFEGUS_PASSWORD=
TRAFEGUS_APP_ID=777
TRAFEGUS_DOCUMENTO=
TRAFEGUS_TIMEOUT_SECONDS=30
TRAFEGUS_RETRY_ATTEMPTS=2
TRACKING_API_KEY=
TOMTOM_API_KEY=
OPENROUTESERVICE_API_KEY=
OPENWEATHER_API_KEY=

# Coletores e persistência (caminhos internos são definidos pelo Compose)
FLEET_COLLECTOR_ENABLED=true
FLEET_COLLECTOR_INTERVAL_SECONDS=60
FLEET_COLLECTOR_INITIAL_DELAY_SECONDS=5
FLEET_ROUTING_ENABLED=false
FLEET_POSITION_FRESH_MINUTES=15
TRAFFIC_COLLECTOR_ENABLED=true
TRAFFIC_COLLECTOR_INTERVAL_SECONDS=180
TRAFFIC_COLLECTOR_INITIAL_DELAY_SECONDS=15
# O cron documentado executa o backup diário; evite duplicá-lo no processo web.
OPERATIONS_BACKUP_ENABLED=false
OPERATIONS_BACKUP_INTERVAL_HOURS=24
OPERATIONS_BACKUP_INITIAL_DELAY_SECONDS=120
OPERATIONS_BACKUP_DAILY_RETENTION=14
OPERATIONS_BACKUP_WEEKLY_RETENTION=4
OPERATIONS_BACKUP_MONTHLY_RETENTION=6

# Regras operacionais já existentes
RETURN_MIN_DESTINATION_STAY_HOURS=18
RETURN_MIN_PROGRESS_KM=40
RETURN_DIRECTION_READINGS=3
RETURN_CORRIDOR_M=1000
ANGELLIRA_DATASET_PATH=data/angellira/2026-07-23-v1
