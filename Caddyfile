{
    email {$ACME_EMAIL}
    admin off
}

{$APP_DOMAIN} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "geolocation=(self), camera=(), microphone=()"
        -Server
    }

    @backend path /api/* /health /fleet/* /trafegus/* /routes/* /integrations/* /tracking/* /operations/* /traffic/* /deviations/* /angellira/* /operational-sites*
    handle @backend {
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy frontend:8080
    }
}

# Exceção temporária e literal enquanto a produção opera somente por IP.
http://190.2.184.66 {
    encode zstd gzip

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "geolocation=(self), camera=(), microphone=()"
        -Server
    }

    @backend path /api/* /health /fleet/* /trafegus/* /routes/* /integrations/* /tracking/* /operations/* /traffic/* /deviations/* /angellira/* /operational-sites*
    handle @backend {
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy frontend:8080
    }
}
